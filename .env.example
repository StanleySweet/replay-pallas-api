# Required. The API refuses to boot without it (src/project_globals.ts).
# Generate one with:  openssl rand -base64 48
# Rotating this invalidates every issued JWT, logging out every session.
JOSE_SECRET=

# Only needed if you publish the API port directly. The default topology keeps
# the API on the internal podman network and reaches it through nginx.
# API_PORT=8080

# Only published port. Frontend origin, e.g. https://replay-pallas.wildfiregames.ovh
WEB_PORT=8080
